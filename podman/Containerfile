FROM python:3.12-slim

LABEL maintainer="unifi-readonly-mcp"
LABEL description="Read-only Ubiquiti UniFi Network MCP server — stdio transport"

# Create a non-root user (uid 1001) to run the server.
RUN useradd --uid 1001 --create-home --shell /bin/bash unifi-mcp

WORKDIR /app

# Install Python dependencies first so Podman can cache this layer.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy the MCP server source. Secrets are NEVER copied in: .env is excluded
# via .containerignore and credentials are mounted at runtime (--env-file or
# --secret type=env), never baked into the image.
COPY server.py .

# Drop privileges before runtime.
USER unifi-mcp

# Unbuffered stdout/stderr keeps MCP stdio framing predictable.
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# stdio transport: the MCP client (Claude Desktop / Claude Code) launches
# this container and talks to it directly over stdin/stdout.
ENTRYPOINT ["python", "server.py"]
