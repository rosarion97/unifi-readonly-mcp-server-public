# Copy this file to .env and fill in the required values.
# The .env file is gitignored AND excluded from the image build via
# .containerignore — it is mounted at runtime with --env-file, never baked
# into the image.
#
# NOTE: .env is the *fallback* (Option 2). The preferred path is a podman
# secret (`podman secret create` + `--secret <name>,type=env`). See README.

# --- REQUIRED -------------------------------------------------------------

# 1) UNIFI_HOST — host or IP of the UniFi OS console (UDM/UCG/UDR/UDW or
#    UniFi OS Server). Do NOT include scheme. Example: 192.168.1.1
UNIFI_HOST=192.168.1.1

# 2) UNIFI_PORT — TLS port on the console.
#    - UniFi OS hardware (UDM/UCG/UDR/UDW): 443
#    - UniFi OS Server (software install on Linux/Mac): 11443
UNIFI_PORT=443

# 3) UNIFI_API_KEY — Network Integration API key.
#    Generate in the UniFi Network UI:
#      Settings -> Control Plane -> Integrations -> Create API Key
#    For maximum safety, create a dedicated Limited Admin (Read-Only) admin
#    first, log in as that admin, and generate the key under their profile.
#    The key inherits the parent admin's permissions, so a read-only admin
#    yields a key that cannot mutate state even if the server were exploited.
UNIFI_API_KEY=your_integration_api_key_here

# 4) UNIFI_SITE_ID — Integration-API site UUID this instance is pinned to.
#    Every site-scoped Integration tool ignores any other site. To discover
#    the UUID, set this to any placeholder, start the server, and call
#    unifi_int_list_sites once — the response contains every site's UUID.
UNIFI_SITE_ID=00000000-0000-0000-0000-000000000000

# --- OPTIONAL: Classic API auth -------------------------------------------
# Required ONLY if you want the unifi_classic_* tools (events, alarms,
# DPI, reports, port forwards, etc.). The Integration tools (unifi_int_*)
# work without these.
#
# IMPORTANT: use a *local* Limited Admin (Read-Only) account on the console.
#   - Settings -> Control Plane -> Admins & Users -> Add Admin
#   - Choose: Restrict to Local Access Only
#   - Role: Limited Admin -> Read-Only
# Never use your UI.com cloud account: UI.com has enforced MFA since
# July 2024 and a non-interactive login will fail with HTTP 499.

UNIFI_CLASSIC_USERNAME=
UNIFI_CLASSIC_PASSWORD=

# --- OPTIONAL: Classic site name ------------------------------------------
# The Classic API uses a SHORT site name, distinct from the Integration UUID.
# The default UniFi site short name is "default" — change only if your
# controller hosts multiple sites and you want to pin a non-default one.
UNIFI_SITE_NAME=default

# --- OPTIONAL: TLS ---------------------------------------------------------
# UniFi OS ships with self-signed certs. Leave UNIFI_VERIFY_TLS=false for
# homelab / on-LAN deployments. Set to true once you've installed a real
# cert on the console.
UNIFI_VERIFY_TLS=false

# --- OPTIONAL: Response-size cap ------------------------------------------
# Cap the size (bytes of JSON) of any single tool response. Prevents huge
# endpoints like /stat/event, /stat/sta, /stat/dpi from blowing past the
# model's context window. The server returns a truncation envelope with a
# `_hint` field when this cap kicks in.
# Defaults to 120000 (~30k tokens). Tune higher for big-window models.
# UNIFI_MAX_RESPONSE_BYTES=120000
